<%= form_with model: [:admin, @endpoint], class: "space-y-6" do |f| %>
  <% if @endpoint.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside text-sm">
        <% @endpoint.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <label class="form-control">
      <span class="label-text text-xs uppercase tracking-wide mb-1">Name</span>
      <%= f.text_field :name, class: "input input-bordered w-full", placeholder: "GitHub deploys" %>
    </label>

    <label class="form-control">
      <span class="label-text text-xs uppercase tracking-wide mb-1">Slug</span>
      <%= f.text_field :slug, class: "input input-bordered w-full font-mono", placeholder: "derived from the name",
          disabled: @endpoint.persisted? && @endpoint.default?, maxlength: Endpoint::SLUG_MAX_LENGTH %>
      <span class="text-xs text-base-content/60 mt-1">
        <% if @endpoint.persisted? && @endpoint.default? %>
          The default endpoint always receives on <code>/webhooks/receive</code>.
        <% else %>
          Webhooks are received on <code>/webhooks/receive/&lt;slug&gt;</code>. Lowercase letters, digits and dashes.
          <% if @endpoint.persisted? %>Changing it changes the URL senders must use.<% end %>
        <% end %>
      </span>
    </label>
  </div>

  <label class="form-control">
    <span class="label-text text-xs uppercase tracking-wide mb-1">Description</span>
    <%= f.text_area :description, rows: 2, class: "textarea textarea-bordered w-full", placeholder: "Optional notes, e.g. which sender posts here" %>
  </label>

  <div class="form-control">
    <span class="label-text text-xs uppercase tracking-wide mb-1">Status</span>
    <label class="cursor-pointer flex items-center gap-3 h-12">
      <%= f.check_box :active, class: "toggle toggle-success" %>
      <span class="text-sm">Accept webhooks (inactive endpoints answer 404 and store nothing)</span>
    </label>
  </div>

  <div class="border-t border-base-300 pt-6">
    <h3 class="font-medium mb-1">Signature verification</h3>
    <p class="text-sm text-base-content/60 mb-3">
      Requests without a valid signature are answered 401 and are neither stored nor forwarded.
      A preset fills in the settings below; they apply as entered only with Generic HMAC.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <label class="form-control">
        <span class="label-text text-xs uppercase tracking-wide mb-1">Verification</span>
        <%= f.select :signature_preset, EndpointsHelper::SIGNATURE_PRESET_LABELS.invert, { include_blank: "None (accept every request)" },
            class: "select select-bordered w-full" %>
      </label>

      <label class="form-control">
        <span class="label-text text-xs uppercase tracking-wide mb-1">Secrets</span>
        <%= f.text_area :signing_secrets, rows: 2, class: "textarea textarea-bordered w-full font-mono", autocomplete: "off",
            placeholder: "One per line; any of them may sign" %>
        <span class="text-xs text-base-content/60 mt-1">Add the new secret on its own line before rotating it at the sender, then remove the old one.</span>
      </label>
    </div>

    <%= tag.details class: "mt-4", open: @endpoint.signature_preset == "generic" do %>
      <summary class="cursor-pointer text-sm font-medium">Generic HMAC settings</summary>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-3">
        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Signature header</span>
          <%= f.text_field :signature_header, class: "input input-bordered w-full font-mono", placeholder: "X-Signature" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Algorithm</span>
          <%= f.select :signature_algorithm, SignatureVerifier::ALGORITHMS.map { |a| [a.upcase.sub("SHA", "SHA-"), a] }, {},
              class: "select select-bordered w-full" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Encoding</span>
          <%= f.select :signature_encoding, [["Hex", "hex"], ["Base64", "base64"]], {}, class: "select select-bordered w-full" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Prefix to strip</span>
          <%= f.text_field :signature_prefix, class: "input input-bordered w-full font-mono", placeholder: "sha256=" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Header format</span>
          <%= f.select :signature_format, [["Plain value", "plain"], ["key=value list (t=...,v1=...)", "key_value"]], {},
              class: "select select-bordered w-full" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Signature key / timestamp key</span>
          <span class="flex gap-2">
            <%= f.text_field :signature_key, class: "input input-bordered w-full font-mono", placeholder: "v1" %>
            <%= f.text_field :timestamp_key, class: "input input-bordered w-full font-mono", placeholder: "t" %>
          </span>
          <span class="text-xs text-base-content/60 mt-1">Only for a key=value list.</span>
        </label>

        <label class="form-control md:col-span-3">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Signed content</span>
          <%= f.text_field :signed_payload_template, class: "input input-bordered w-full font-mono", placeholder: "{body}" %>
          <span class="text-xs text-base-content/60 mt-1">
            <code>{body}</code> is the raw body; <code>{timestamp}</code> and <code>{header:Name}</code> insert the timestamp or a header value.
          </span>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Timestamp header</span>
          <%= f.text_field :timestamp_header, class: "input input-bordered w-full font-mono", placeholder: "X-Timestamp" %>
        </label>

        <label class="form-control">
          <span class="label-text text-xs uppercase tracking-wide mb-1">Timestamp tolerance (seconds)</span>
          <%= f.number_field :timestamp_tolerance, min: 1, class: "input input-bordered w-full", placeholder: "No replay check" %>
        </label>
      </div>
    <% end %>
  </div>

  <div class="border-t border-base-300 pt-6">
    <h3 class="font-medium mb-1">Forward to targets</h3>
    <p class="text-sm text-base-content/60 mb-3">Webhooks received here go to the selected targets, each still subject to its own filters.</p>
    <% targets = Target.order(:name) %>
    <% if targets.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <%= f.collection_check_boxes :target_ids, targets, :id, :name do |b| %>
          <label class="flex items-center gap-3 bg-base-200 rounded-box px-3 py-2 cursor-pointer">
            <%= b.check_box class: "checkbox checkbox-sm" %>
            <span class="text-sm min-w-0">
              <span class="font-medium"><%= b.text %></span>
              <span class="block font-mono text-xs text-base-content/60 truncate"><%= b.object.url %></span>
            </span>
            <% unless b.object.active? %>
              <span class="badge badge-xs badge-ghost ml-auto">inactive</span>
            <% end %>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-base-content/60">No targets yet. <%= link_to "Add a target", new_admin_target_path, class: "link" %> first.</p>
    <% end %>
  </div>

  <div class="border-t border-base-300 pt-6 flex gap-2">
    <%= f.submit @endpoint.new_record? ? "Create Endpoint" : "Update Endpoint", class: "btn btn-primary" %>
    <%= link_to "Cancel", @endpoint.persisted? ? admin_endpoint_path(@endpoint) : admin_endpoints_path, class: "btn btn-ghost" %>
  </div>
<% end %>
